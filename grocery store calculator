# Grocery store_casestudy
items = []
prices = []
num_items = int(input("How many different items do you want to buy? "))
for i in range(num_items):
    item_name = input(f"Enter the name of item {i+1}: ")
    item_price = float(input(f"Enter the price of {item_name}: rupees"))
    items.append(item_name)
    prices.append(item_price)
total_cost = sum(prices)
print("\nYour grocery list:")
for i in range(num_items):
    print(f"{items[i]}: rupees{prices[i]:.2f}")
print(f"\nTotal cost: rupees{total_cost:.2f}")
